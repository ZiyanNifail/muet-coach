{
  "name": "presentation-coach-fyp",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && venv/Scripts/uvicorn main:app --reload --port 8000"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
