# ── Backend environment variables ────────────────────────────────────────────
# Copy to backend/.env and fill in real values. Never commit the real .env.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Groq (speech-to-text + LLM feedback)
GROQ_API_KEY=gsk_your_groq_key
WHISPER_MODEL=whisper-large-v3-turbo

# Admin panel — verified server-side, returned key is used as X-Admin-Key.
# Use a strong, unique password (do NOT reuse a demo value).
ADMIN_ID=admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_ACCESS_KEY=generate-a-long-random-string

# CORS / app
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# Optional — text-to-speech (only if interview/TTS features are used)
# ELEVENLABS_API_KEY=
